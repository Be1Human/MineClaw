{
  "id": "short-follow-owner-to-marker",
  "description": "Prepare TC-SC-17 with the Bot beside the owner and a straight ten-block route to a yellow marker.",
  "commands": [
    "gamerule doMobSpawning false",
    "gamerule doDaylightCycle false",
    "gamerule doWeatherCycle false",
    "time set day",
    "weather clear",
    "execute at {{owner}} run kill @e[type=item,distance=..16]",
    "clear {{bot}}",
    "fill 48 -61 33 64 -61 41 minecraft:stone",
    "fill 48 -60 33 64 -57 41 minecraft:air",
    "fill 62 -61 37 62 -61 37 minecraft:yellow_concrete",
    "tp {{owner}} 54 -60 37 90 0",
    "tp {{bot}} 52 -60 37 90 0"
  ]
}
