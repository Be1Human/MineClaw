    "execute at {{bot}} run summon minecraft:zombie ~5 ~ ~3 {Tags:[\"mineclaw_test\"],NoAI:0b,Silent:1b,PersistenceRequired:1b,CanPickUpLoot:0b,Health:20.0f}",
    "execute at {{bot}} run summon minecraft:zombie ~5 ~ ~-3 {Tags:[\"mineclaw_test\"],NoAI:0b,Silent:1b,PersistenceRequired:1b,CanPickUpLoot:0b,Health:20.0f}"
